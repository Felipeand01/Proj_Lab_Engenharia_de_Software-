# Copie para .env e ajuste: cp .env.example .env
# O arquivo .env NÃO é versionado. Nunca coloque valores reais neste exemplo.

# Banco de dados. O valor abaixo é o usuário/senha de DESENVOLVIMENTO do
# docker-compose.yml. Em produção use as credenciais do banco gerenciado.
DATABASE_URL=postgresql+psycopg://amigo_user:amigo_pass@localhost:5432/amigo_vizinhanca

# Segredo do JWT (obrigatório, mínimo de 32 caracteres; sem ele a API não inicia).
# Gere um com: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
# Validade do token em minutos (opcional, padrão 60).
JWT_EXPIRA_MINUTOS=60

# Origens permitidas no CORS, separadas por vírgula (padrão: Expo local).
# Em produção, informe somente a URL do frontend publicado.
CORS_ORIGINS=http://localhost:8081,http://localhost:19006
# Opcional: regex de origens extras (ex.: Codespaces). Deixe vazio em produção.
CORS_ORIGIN_REGEX=

# Fotos das ocorrências. "local" grava em backend/uploads e serve em /fotos (só
# desenvolvimento: o disco de hospedagens como o Render é efêmero). Em produção use "cloudinary".
FOTO_STORAGE=local
# Tamanho máximo da foto em bytes (opcional, padrão 5 MB).
FOTO_MAX_BYTES=5242880
# Só com FOTO_STORAGE=cloudinary. Segredos exclusivos do backend: nunca no frontend.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Primeiro administrador (usado só por: python -m backend.app.seed).
# Defina a senha (mínimo 8 caracteres) apenas no seu .env local.
ADMIN_EMAIL=admin@exemplo.com
ADMIN_SENHA=
ADMIN_NOME=Administrador
